# --- База даних (PostgreSQL) ---
POSTGRES_DB=downloader
POSTGRES_USER=downloader_user
POSTGRES_PASSWORD=secure_downloader_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://downloader_user:secure_downloader_password@postgres:5432/downloader

# --- Черги та брокер (Redis) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- S3 Сховище (SeaweedFS) ---
S3_ENDPOINT_URL=http://seaweedfs:8333
S3_ACCESS_KEY=any_access_key
S3_SECRET_KEY=any_secret_key
S3_BUCKET_NAME=vault
S3_REGION=us-east-1

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ALLOWED_USERS=your_telegram_id_here

# --- Ліміти та параметри завантажувача ---
MAX_FILE_SIZE_CONFIRMATION_BYTES=2147483648 # 2 ГБ
DEFAULT_VIDEO_QUALITY=1080p
DOWNLOAD_TEMP_DIR=/tmp/downloads